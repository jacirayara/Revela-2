{%- style -%}
  #Testimonials-{{ section.id }} {
    --testimonial-columns: {{ section.settings.columns_desktop }};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__header {
    max-width: 72rem;
    margin: 0 auto 3.2rem;
    text-align: {{ section.settings.text_alignment }};
  }

  #Testimonials-{{ section.id }} .revela-testimonials__heading {
    margin: 0 0 1rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__intro > *:first-child,
  #Testimonials-{{ section.id }} .revela-testimonial__quote > *:first-child {
    margin-top: 0;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__intro > *:last-child,
  #Testimonials-{{ section.id }} .revela-testimonial__quote > *:last-child {
    margin-bottom: 0;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__grid {
    display: grid;
    grid-template-columns: repeat(var(--testimonial-columns), minmax(0, 1fr));
    gap: 2rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonial {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 0.1rem solid rgba(var(--color-foreground), 0.16);
    border-radius: {{ section.settings.card_radius }}px;
    background: rgb(var(--color-background));
    box-shadow: none;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: rgba(var(--color-foreground), 0.04);
  }

  #Testimonials-{{ section.id }} .revela-testimonial__media img,
  #Testimonials-{{ section.id }} .revela-testimonial__media video,
  #Testimonials-{{ section.id }} .revela-testimonial__media iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    object-fit: cover;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__media-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 2.4rem;
    text-align: center;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__play {
    display: grid;
    width: 6rem;
    height: 6rem;
    margin: 0 auto 1.4rem;
    place-items: center;
    border: 0.1rem solid rgba(var(--color-foreground), 0.35);
    border-radius: 50%;
    font-size: 1.8rem;
    line-height: 1;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__media-label {
    display: block;
    max-width: 28rem;
    font-size: 1.4rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 2.4rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__placeholder {
    align-self: flex-start;
    margin-bottom: 1.6rem;
    padding: 0.5rem 1rem;
    border-radius: 0.3rem;
    background: rgba(var(--color-foreground), 0.08);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__quote {
    margin: 0;
    font-size: 1.7rem;
    line-height: 1.65;
  }

  #Testimonials-{{ section.id }} .revela-testimonial--featured {
    grid-column: span 2;
  }

  #Testimonials-{{ section.id }} .revela-testimonial--featured .revela-testimonial__quote {
    max-width: 68rem;
    font-size: clamp(2rem, 2.2vw, 2.7rem);
    line-height: 1.45;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__author {
    margin-top: auto;
    padding-top: 2rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__name {
    display: block;
    font-weight: 700;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__details {
    display: block;
    margin-top: 0.2rem;
    opacity: 0.72;
  }

  #Testimonials-{{ section.id }} .revela-testimonial__consent {
    display: block;
    margin-top: 1rem;
    font-size: 1.4rem;
    line-height: 1.45;
    opacity: 0.78;
  }

  #Testimonials-{{ section.id }} .revela-testimonial--video {
    grid-column: span {{ section.settings.video_width }};
  }

  #Testimonials-{{ section.id }} .revela-testimonials__empty {
    grid-column: 1 / -1;
    padding: 4rem 2rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    text-align: center;
  }

  #Testimonials-{{ section.id }} .revela-testimonial[hidden] {
    display: none;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__footer {
    margin-top: 3.2rem;
    text-align: center;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__form-wrap {
    max-width: 78rem;
    margin: 5.6rem auto 0;
    padding: clamp(2.4rem, 5vw, 4.8rem);
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.18);
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.18);
    scroll-margin-top: 3rem;
    background: rgba(var(--color-foreground), 0.025);
  }

  #Testimonials-{{ section.id }} .revela-testimonials__form-heading {
    margin: 0 0 0.8rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__form-intro {
    margin: 0 0 2.4rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__field--full,
  #Testimonials-{{ section.id }} .revela-testimonials__permissions,
  #Testimonials-{{ section.id }} .revela-testimonials__form-actions {
    grid-column: 1 / -1;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__label {
    display: block;
    margin-bottom: 0.7rem;
    font-weight: 600;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__input,
  #Testimonials-{{ section.id }} .revela-testimonials__textarea {
    width: 100%;
    padding: 1.3rem 1.5rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.3);
    border-radius: 0;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    font: inherit;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__textarea {
    min-height: 15rem;
    resize: vertical;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__input:focus,
  #Testimonials-{{ section.id }} .revela-testimonials__textarea:focus {
    outline: 0.2rem solid rgba(var(--color-foreground), 0.65);
    outline-offset: 0.2rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__permissions {
    display: grid;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__checkbox-label {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    align-items: start;
    cursor: pointer;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__checkbox {
    width: 1.8rem;
    height: 1.8rem;
    margin: 0.2rem 0 0;
    accent-color: rgb(var(--color-foreground));
  }

  #Testimonials-{{ section.id }} .revela-testimonials__connection-note {
    margin: 1.8rem 0 0;
    padding: 1.2rem 1.5rem;
    border-left: 0.3rem solid rgba(var(--color-foreground), 0.4);
    font-size: 1.25rem;
    opacity: 0.75;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__status {
    margin-bottom: 1.8rem;
    padding: 1.2rem 1.5rem;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__status--success {
    background: rgba(46, 125, 50, 0.12);
  }

  #Testimonials-{{ section.id }} .revela-testimonials__status--error {
    background: rgba(183, 28, 28, 0.1);
  }

  #Testimonials-{{ section.id }} .revela-testimonials__note {
    max-width: 62rem;
    margin: 1.2rem auto 0;
    font-size: 1.3rem;
    opacity: 0.72;
  }

  #Testimonials-{{ section.id }} .revela-testimonials__admin-note {
    max-width: 76rem;
    margin: 2.4rem auto 0;
    padding: 1.4rem 1.6rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    font-size: 1.3rem;
    line-height: 1.5;
    opacity: 0.78;
  }

  @media screen and (min-width: 750px) {
    #Testimonials-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 989px) {
    #Testimonials-{{ section.id }} .revela-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #Testimonials-{{ section.id }} .revela-testimonials__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(86vw, 32rem);
      justify-content: start;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      padding: 0.2rem 0.2rem 1.4rem;
      scroll-snap-type: inline mandatory;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    #Testimonials-{{ section.id }} .revela-testimonial {
      scroll-snap-align: start;
    }

    #Testimonials-{{ section.id }} .revela-testimonial--video {
      grid-column: auto;
    }

    #Testimonials-{{ section.id }} .revela-testimonial--featured {
      grid-column: auto;
    }

    #Testimonials-{{ section.id }} .revela-testimonials__fields {
      grid-template-columns: 1fr;
    }

    #Testimonials-{{ section.id }} .revela-testimonials__field,
    #Testimonials-{{ section.id }} .revela-testimonials__permissions,
    #Testimonials-{{ section.id }} .revela-testimonials__form-actions {
      grid-column: 1;
    }
  }
{%- endstyle -%}

<section id="Testimonials-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- liquid
      assign testimonials_source = section.settings.testimonials_source | default: 'blocks'
      assign metaobject_type = section.settings.metaobject_type | default: 'revela_testimonial'
      assign metaobject_entries = shop.metaobjects[metaobject_type].values
      assign use_metaobjects = false

      if testimonials_source == 'metaobjects' and metaobject_entries != blank
        assign use_metaobjects = true
      endif

      assign rendered_count = 0
      assign initial_visible = section.settings.initial_visible | default: 6
      assign max_metaobjects = section.settings.max_metaobjects | default: 24
    -%}

    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="revela-testimonials__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="revela-testimonials__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="revela-testimonials__intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="revela-testimonials__grid" data-testimonials-grid data-initial-visible="{{ initial_visible }}">
      {%- if use_metaobjects -%}
        {%- for testimonial in metaobject_entries -%}
          {%- liquid
            assign is_approved = testimonial.approved.value | default: testimonial.approved
            assign should_show = true

            if section.settings.show_approved_only and is_approved != true and is_approved != 'true' and is_approved != 'Yes' and is_approved != 'yes'
              assign should_show = false
            endif

            assign quote = testimonial.review.value | default: testimonial.quote.value | default: testimonial.testimonial.value
            assign name = testimonial.name.value | default: testimonial.customer_name.value
            assign details = testimonial.details.value | default: testimonial.customer_details.value | default: testimonial.location.value
            assign consent_text = testimonial.consent_text.value | default: testimonial.attribution.value
            assign image = testimonial.image.value | default: testimonial.photo.value | default: testimonial.customer_photo.value
            assign video = testimonial.video.value | default: testimonial.customer_video.value
            assign video_url = testimonial.video_url.value | default: testimonial.external_video_url.value
            assign featured = testimonial.featured.value | default: testimonial.featured
            assign has_video = false

            if video != blank or video_url != blank
              assign has_video = true
            endif
          -%}

          {%- if should_show and quote != blank -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            <article
              class="revela-testimonial{% if rendered_count == 1 or featured == true or featured == 'true' or featured == 'Yes' %} revela-testimonial--featured{% endif %}{% if has_video %} revela-testimonial--video{% endif %}"
              data-testimonial-card
              {% if rendered_count > initial_visible and section.settings.enable_load_more %}hidden{% endif %}
            >
              {%- if video != blank or video_url != blank or image != blank -%}
                <div class="revela-testimonial__media">
                  {%- if video != blank -%}
                    {{ video | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
                  {%- elsif video_url != blank -%}
                    {{ video_url | external_video_url: autoplay: false | external_video_tag: loading: 'lazy', title: name }}
                  {%- else -%}
                    {{
                      image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900, 1200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                        alt: image.alt
                    }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="revela-testimonial__content">
                <blockquote class="revela-testimonial__quote rte">
                  <p>{{ quote | escape }}</p>
                </blockquote>
                {%- if name != blank or details != blank or consent_text != blank -%}
                  <footer class="revela-testimonial__author">
                    {%- if name != blank -%}
                      <span class="revela-testimonial__name">{{ name | escape }}</span>
                    {%- endif -%}
                    {%- if details != blank -%}
                      <span class="revela-testimonial__details">{{ details | escape }}</span>
                    {%- endif -%}
                    {%- if consent_text != blank -%}
                      <span class="revela-testimonial__consent">{{ consent_text | escape }}</span>
                    {%- endif -%}
                  </footer>
                {%- endif -%}
              </div>
            </article>

            {%- if rendered_count >= max_metaobjects -%}
              {%- break -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if rendered_count == 0 and request.design_mode -%}
          <div class="revela-testimonials__empty">No approved testimonial metaobjects found yet. Add entries in Shopify admin or switch this section back to theme blocks.</div>
        {%- endif -%}
      {%- else -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'testimonial' -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            <article
              class="revela-testimonial{% if forloop.first %} revela-testimonial--featured{% endif %}"
              data-testimonial-card
              {% if rendered_count > initial_visible and section.settings.enable_load_more %}hidden{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- comment -%}
                FINAL CLIENT CONTENT: replace the placeholder label, testimonial, customer identity,
                image and consent wording in this block after Liezel supplies written approval.
              {%- endcomment -%}
              {%- if block.settings.image != blank or block.settings.image_asset != blank -%}
                <div class="revela-testimonial__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900, 1200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                        alt: block.settings.image.alt
                    }}
                  {%- else -%}
                    <img
                      src="{{ block.settings.image_asset | asset_url }}"
                      alt="{{ block.settings.name | escape }}"
                      loading="lazy"
                      width="1200"
                      height="1200"
                    >
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="revela-testimonial__content">
                {%- if block.settings.placeholder_label != blank -%}
                  <span class="revela-testimonial__placeholder">{{ block.settings.placeholder_label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <blockquote class="revela-testimonial__quote rte">{{ block.settings.quote }}</blockquote>
                {%- endif -%}
                {%- if block.settings.name != blank or block.settings.details != blank -%}
                  <footer class="revela-testimonial__author">
                    {%- if block.settings.name != blank -%}
                      <span class="revela-testimonial__name">{{ block.settings.name | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.details != blank -%}
                      <span class="revela-testimonial__details">{{ block.settings.details | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.consent_text != blank -%}
                      <span class="revela-testimonial__consent">{{ block.settings.consent_text | escape }}</span>
                    {%- endif -%}
                  </footer>
                {%- endif -%}
              </div>
            </article>

          {%- when 'video' -%}
            {%- assign rendered_count = rendered_count | plus: 1 -%}
            <article
              class="revela-testimonial revela-testimonial--video"
              data-testimonial-card
              {% if rendered_count > initial_visible and section.settings.enable_load_more %}hidden{% endif %}
              {{ block.shopify_attributes }}
            >
              {%- comment -%}
                FINAL CLIENT VIDEO: upload the approved video to Shopify Files or add its approved
                YouTube/Vimeo URL here. Confirm customer attribution and media consent before use.
              {%- endcomment -%}
              {%- if block.settings.video != blank or block.settings.video_url != blank or block.settings.video_asset != blank -%}
                <div class="revela-testimonial__media">
                  {%- if block.settings.video != blank -%}
                    {{ block.settings.video | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}
                  {%- elsif block.settings.video_asset != blank -%}
                    <video controls preload="metadata">
                      <source src="{{ block.settings.video_asset | asset_url }}" type="video/mp4">
                    </video>
                  {%- else -%}
                    {{
                      block.settings.video_url
                      | external_video_url: autoplay: false
                      | external_video_tag: loading: 'lazy', title: block.settings.video_title
                    }}
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="revela-testimonial__media" aria-label="Video testimonial placeholder">
                  <div class="revela-testimonial__media-placeholder">
                    <div>
                      <span class="revela-testimonial__play" aria-hidden="true">&#9654;</span>
                      <span class="revela-testimonial__media-label">Approved customer video will appear here.</span>
                    </div>
                  </div>
                </div>
              {%- endif -%}
              <div class="revela-testimonial__content">
                {%- if block.settings.placeholder_label != blank -%}
                  <span class="revela-testimonial__placeholder">{{ block.settings.placeholder_label | escape }}</span>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <blockquote class="revela-testimonial__quote rte">{{ block.settings.quote }}</blockquote>
                {%- endif -%}
                {%- if block.settings.name != blank or block.settings.details != blank or block.settings.consent_text != blank -%}
                  <footer class="revela-testimonial__author">
                    {%- if block.settings.name != blank -%}
                      <span class="revela-testimonial__name">{{ block.settings.name | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.details != blank -%}
                      <span class="revela-testimonial__details">{{ block.settings.details | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.consent_text != blank -%}
                      <span class="revela-testimonial__consent">{{ block.settings.consent_text | escape }}</span>
                    {%- endif -%}
                  </footer>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- else -%}
        {%- if request.design_mode -%}
          <div class="revela-testimonials__empty">Add testimonial or video blocks to this section.</div>
        {%- endif -%}
      {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.enable_load_more and rendered_count > initial_visible -%}
      <div class="revela-testimonials__footer">
        <button type="button" class="button button--secondary" data-testimonials-load-more>
          {{ section.settings.load_more_label | escape }}
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="revela-testimonials__footer">
        <a
          class="button{% if section.settings.button_style_secondary %} button--secondary{% endif %}"
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#TestimonialForm-{{ section.id }}{% endif %}"
        >
          {{ section.settings.button_label | escape }}
        </a>
        {%- if section.settings.submission_note != blank -%}
          <div class="revela-testimonials__note rte">{{ section.settings.submission_note }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_feedback_form -%}
      <div id="TestimonialForm-{{ section.id }}" class="revela-testimonials__form-wrap">
        <h3 class="revela-testimonials__form-heading h2">{{ section.settings.form_heading | escape }}</h3>
        {%- if section.settings.form_intro != blank -%}
          <div class="revela-testimonials__form-intro rte">{{ section.settings.form_intro }}</div>
        {%- endif -%}

        {%- comment -%}
          NATIVE SHOPIFY FORM: this submits to Shopify's contact-form endpoint and does not publish
          anything to the storefront. Configure the final recipient/Shopify Forms workflow after
          Liezel confirms the destination email and consent wording.
        {%- endcomment -%}
        {%- form 'contact', id: 'RevelaTestimonialForm', class: 'revela-testimonials__form' -%}
          <input type="hidden" name="contact[Submission type]" value="Testimonial or customer feedback">

          {%- if form.posted_successfully? -%}
            <div class="revela-testimonials__status revela-testimonials__status--success" role="status" tabindex="-1">
              {{ section.settings.success_message | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="revela-testimonials__status revela-testimonials__status--error" role="alert" tabindex="-1">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="revela-testimonials__fields">
            <div class="revela-testimonials__field">
              <label class="revela-testimonials__label" for="TestimonialName-{{ section.id }}">Name <span aria-hidden="true">*</span></label>
              <input class="revela-testimonials__input" id="TestimonialName-{{ section.id }}" type="text" name="contact[Name]" autocomplete="name" required>
            </div>

            <div class="revela-testimonials__field">
              <label class="revela-testimonials__label" for="TestimonialEmail-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
              <input class="revela-testimonials__input" id="TestimonialEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            </div>

            <div class="revela-testimonials__field revela-testimonials__field--full">
              <label class="revela-testimonials__label" for="TestimonialRole-{{ section.id }}">Company or role</label>
              <input class="revela-testimonials__input" id="TestimonialRole-{{ section.id }}" type="text" name="contact[Company or role]" autocomplete="organization-title">
            </div>

            <div class="revela-testimonials__field revela-testimonials__field--full">
              <label class="revela-testimonials__label" for="TestimonialMessage-{{ section.id }}">Testimonial or feedback <span aria-hidden="true">*</span></label>
              <textarea class="revela-testimonials__textarea" id="TestimonialMessage-{{ section.id }}" name="contact[Testimonial or feedback]" required></textarea>
            </div>

            <fieldset class="revela-testimonials__permissions">
              <legend class="revela-testimonials__label">Permissions</legend>
              <label class="revela-testimonials__checkbox-label" for="TestimonialPublish-{{ section.id }}">
                <input class="revela-testimonials__checkbox" id="TestimonialPublish-{{ section.id }}" type="checkbox" name="contact[Permission to publish feedback]" value="Yes">
                <span>{{ section.settings.publish_permission_label | escape }}</span>
              </label>
              <label class="revela-testimonials__checkbox-label" for="TestimonialMedia-{{ section.id }}">
                <input class="revela-testimonials__checkbox" id="TestimonialMedia-{{ section.id }}" type="checkbox" name="contact[Permission to use image or video]" value="Yes">
                <span>{{ section.settings.media_permission_label | escape }}</span>
              </label>
            </fieldset>

            <div class="revela-testimonials__form-actions">
              <button class="button" type="submit">{{ section.settings.submit_label | escape }}</button>
            </div>
          </div>
        {%- endform -%}

        {%- if request.design_mode and section.settings.form_connection_note != blank -%}
          <p class="revela-testimonials__connection-note">{{ section.settings.form_connection_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if request.design_mode and section.settings.admin_note != blank -%}
      <div class="revela-testimonials__admin-note">
        {{ section.settings.admin_note | escape }}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('Testimonials-{{ section.id }}');
    if (!section) return;

    const button = section.querySelector('[data-testimonials-load-more]');
    if (!button) return;

    button.addEventListener('click', () => {
      section.querySelectorAll('[data-testimonial-card][hidden]').forEach((card) => {
        card.hidden = false;
      });
      button.hidden = true;
    });
  })();
</script>

